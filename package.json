{
  "name": "tag-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TAG - a real-time side-view multiplayer platformer chase game with online, LAN, and AI play.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "generate:audio": "node scripts/generate-audio.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "npm test && npm run build",
    "test:lan": "node scripts/test-lan.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "howler": "^2.2.4",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
